# Copy this file to .env (gitignored) and fill in real values. Never commit .env.

SHOPIFY_ADMIN_TOKEN=          # Custom app Admin API access token (shpat_...)
SHOPIFY_SHOP_DOMAIN=          # e.g. your-store.myshopify.com, no protocol
ANTHROPIC_API_KEY=            # Claude API key used for classify/extract calls
PIPELINE_LIMIT=               # Optional: positive integer to cap products processed in a dry run
