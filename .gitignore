# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# NOTE: unanchored so this matches node_modules at ANY depth, not just the repo
# root. The previous "/node_modules" matched only the root, which is how
# client/node_modules and server/node_modules (40,400 files) got committed.
node_modules/
/.pnp
.pnp.js

# secrets — never commit a real .env; .env.sample is the tracked template
.env
.env.*
!.env.sample

# testing
/coverage

# production / build artifacts
build/
dist/

# caches
.cache/
.eslintcache

# misc
.DS_Store

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# review-queue state: holds HUMAN REVIEW DECISIONS, which cannot be
# regenerated, plus unreviewed extraction output. Not committed; every save
# is atomic and keeps the previous version as candidates.json.bak — copy
# that somewhere safe if the decisions matter to you.
data/candidates.json
data/candidates.json.bak
# temp file of an in-progress atomic save (only left behind by a crash)
data/.candidates.json.*.tmp
