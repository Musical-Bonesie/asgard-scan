# Copy to .env and fill in. Never commit the real .env.

# Port the API listens on.
PORT=8080

# Signing key for JWTs. Generate a high-entropy value -- do NOT pick a
# memorable string, and rotate it if it is ever exposed:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of browser origins allowed to call this API.
# The server previously used a bare cors(), which allowed every origin.
CORS_ORIGINS=http://localhost:3000

# Prisma connection string.
DATABASE_URL="mysql://user:password@localhost:3306/asgardscan"
