# Copy to .env and fill in. Never commit the real .env.
#
# Vite only exposes variables prefixed with VITE_ to client code, and reads
# them via import.meta.env (CRA's process.env.REACT_APP_* does not exist here).
#
# Anything in here is bundled into the JavaScript and is therefore PUBLIC.
# Never put a secret in this file.

# Base URL of the asgard-scan API.
VITE_API_URL=http://localhost:8080
